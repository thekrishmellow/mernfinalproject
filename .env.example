# Server Port & Environment
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Leave empty to automatically start in-memory MongoDB for zero-config development
MONGO_URI=mongodb://127.0.0.1:27017/personalized_roadmap

# Authentication & Session Security
JWT_SECRET=replace-with-a-cryptographically-secure-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-random-cookie-secret
COOKIE_SAME_SITE=lax

# Storage Configuration
# 'local' uses the server/uploads directory; 's3' or cloud storage can be plugged in
STORAGE_ADAPTER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Email Service Configuration
# 'development' logs email links to the console and in-memory outbox
# 'smtp' connects to production mail servers (SendGrid, Mailgun, AWS SES, Postmark, etc.)
EMAIL_PROVIDER=development
EMAIL_FROM=support@roadmaplearning.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Initial Bootstrap Administrator (created automatically on first launch if DB is empty)
ADMIN_EMAIL=admin@roadmap.local
ADMIN_PASSWORD=Admin@123456!
