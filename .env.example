# ===================================================
# Pathfinder Environment Configuration Template
# ===================================================

# ---------------------------------------------------
# Server & Client URLs
# ---------------------------------------------------
PORT=5001
NODE_ENV=development

# When deploying frontend to Vercel, set CLIENT_URL to your Vercel domain:
# e.g. CLIENT_URL=https://your-pathfinder-app.vercel.app
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------
# Database Configuration (MongoDB Atlas Cluster)
# ---------------------------------------------------
# Example Atlas connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pathfinder?retryWrites=true&w=majority

# ---------------------------------------------------
# Authentication & Security
# ---------------------------------------------------
JWT_SECRET=super-secret-production-grade-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-salt-random-string
COOKIE_SAME_SITE=lax

# ---------------------------------------------------
# Storage Configuration
# ---------------------------------------------------
STORAGE_ADAPTER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# ---------------------------------------------------
# Email Service Configuration (Real SMTP / Mail Sending)
# ---------------------------------------------------
# Options: 'development' (logs link in terminal) or 'smtp' (sends real email)
EMAIL_PROVIDER=smtp
EMAIL_FROM=support@pathfinderlearning.com

# --- OPTION A: Gmail SMTP Setup ---
# 1. Enable 2-Step Verification in Google Account
# 2. Go to myaccount.google.com/apppasswords and create an "App Password" (16 chars)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password

# --- OPTION B: Brevo (formerly Sendinblue) / SendGrid / Resend ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-login-email
# SMTP_PASS=your-smtp-api-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------
# Initial Bootstrap Administrator (Auto-created on launch)
# ---------------------------------------------------
ADMIN_EMAIL=admin@roadmap.local
ADMIN_PASSWORD=Admin@123456!

# ---------------------------------------------------
# Google OAuth Configuration (Google Identity Services)
# ---------------------------------------------------
# Create OAuth 2.0 Client ID in Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=888827375910-i4e2l7nl7lsipm675mn0tj4n1svj46ep.apps.googleusercontent.com

# ---------------------------------------------------
# Frontend Environment Variable (Set in Vercel Dashboard)
# ---------------------------------------------------
# VITE_API_URL=https://your-server-backend.onrender.com/api/v1

