{
  "name": "personalized-roadmap-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-minded full-stack personalized learning roadmap platform with visual builder and gated progression engine",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "rm -rf dist && npm run build --workspace=client && cp -r client/dist dist",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
