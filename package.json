{
  "name": "personalized-roadmap-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-minded full-stack personalized learning roadmap platform with visual builder and gated progression engine",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
